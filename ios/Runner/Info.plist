	<string>Ung dung can truy cap camera de chup anh mon an.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Ung dung can truy cap thu vien anh de chon anh mon an.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>Ung dung co the luu anh sau khi xu ly dinh duong.</string>
